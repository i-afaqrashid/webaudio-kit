{
  "name": "webaudio-kit-workspace",
  "version": "1.10.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.4",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/i-afaqrashid/webaudio-kit.git"
  },
  "homepage": "https://github.com/i-afaqrashid/webaudio-kit#readme",
  "bugs": {
    "url": "https://github.com/i-afaqrashid/webaudio-kit/issues"
  },
  "author": "i-afaqrashid <i.afaqrashid@gmail.com>",
  "scripts": {
    "build": "pnpm -r --filter './packages/*' build",
    "size": "size-limit",
    "bench": "node scripts/run-benchmarks.mjs",
    "site:dev": "pnpm --filter @webaudio-kit/site dev",
    "site:build": "pnpm --filter @webaudio-kit/site build",
    "site:start": "pnpm --filter @webaudio-kit/site start",
    "site:qa": "node scripts/site-qa.mjs",
    "demo:dev": "pnpm --filter @webaudio-kit/demo dev",
    "demo:build": "pnpm --filter @webaudio-kit/demo build",
    "demo:qa": "node scripts/demo-qa.mjs",
    "examples:check": "node scripts/check-example-apps.mjs",
    "smoke:pack": "node scripts/smoke-pack.mjs",
    "release:check": "pnpm verify && pnpm smoke:pack && pnpm examples:check -- --skip-build",
    "release:check:full": "pnpm release:check && pnpm demo:qa",
    "release:check:tag": "pnpm release:verify-tag",
    "release:verify-tag": "node scripts/check-release-tag.mjs",
    "release:notes": "node scripts/release-notes.mjs",
    "release:sync-changelogs": "node scripts/sync-package-changelogs.mjs --write",
    "release:check-changelogs": "node scripts/sync-package-changelogs.mjs --check",
    "release:publish-tarballs": "node scripts/publish-packages.mjs",
    "release:dry-run": "pnpm smoke:pack && pnpm release:publish-tarballs .release-packages --dry-run",
    "typecheck": "tsc -p tsconfig.base.json --noEmit",
    "test": "vitest run --coverage && pnpm test:scripts",
    "test:scripts": "node --test scripts/*.test.mjs",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "lint": "eslint . --max-warnings=0",
    "format:check": "prettier --check .",
    "verify": "pnpm test && pnpm typecheck && pnpm build && pnpm size && pnpm demo:build && pnpm site:build && pnpm release:check-changelogs && pnpm lint && pnpm format:check"
  },
  "engines": {
    "node": ">=20.19"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@size-limit/preset-small-lib": "^12.1.0",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^25.9.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "@vitest/coverage-v8": "4.1.9",
    "eslint": "^10.5.0",
    "jsdom": "^29.1.1",
    "playwright": "^1.60.0",
    "prettier": "^3.8.4",
    "size-limit": "^12.1.0",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.0",
    "vite": "^8.0.16",
    "vitest": "^4.1.9"
  },
  "dependencies": {
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  }
}
