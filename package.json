{
  "name": "webaudio-kit-workspace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.4",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/i-afaqrashid/webaudio-kit.git"
  },
  "homepage": "https://github.com/i-afaqrashid/webaudio-kit#readme",
  "bugs": {
    "url": "https://github.com/i-afaqrashid/webaudio-kit/issues"
  },
  "author": "i-afaqrashid <i.afaqrashid@gmail.com>",
  "scripts": {
    "build": "pnpm -r --filter './packages/*' build",
    "demo:dev": "pnpm --filter @webaudio-kit/demo dev",
    "demo:build": "pnpm --filter @webaudio-kit/demo build",
    "demo:qa": "node scripts/demo-qa.mjs",
    "smoke:pack": "node scripts/smoke-pack.mjs",
    "release:check": "pnpm verify && pnpm smoke:pack",
    "release:check:full": "pnpm release:check && pnpm demo:qa",
    "release:check:tag": "node scripts/check-release-tag.mjs",
    "release:dry-run": "node scripts/npm-publish-dry-run.mjs",
    "typecheck": "tsc -p tsconfig.base.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "verify": "pnpm test && pnpm typecheck && pnpm build && pnpm demo:build && pnpm lint && pnpm format:check"
  },
  "engines": {
    "node": ">=20.10"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^25.9.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.2",
    "eslint": "^10.4.0",
    "jsdom": "^28.0.0",
    "playwright": "^1.60.0",
    "prettier": "^3.7.4",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.49.0",
    "vite": "^8.0.14",
    "vitest": "^4.0.15"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  }
}
