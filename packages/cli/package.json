{
  "name": "@webaudio-kit/cli",
  "version": "1.4.1",
  "type": "module",
  "description": "CLI helpers for webaudio-kit projects.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/i-afaqrashid/webaudio-kit.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/i-afaqrashid/webaudio-kit#readme",
  "bugs": {
    "url": "https://github.com/i-afaqrashid/webaudio-kit/issues"
  },
  "keywords": [
    "web-audio",
    "webaudio",
    "audio",
    "typescript",
    "cli",
    "ai",
