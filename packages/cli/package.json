  "publishConfig": {
    "access": "public"
  },
  "author": "i-afaqrashid <i.afaqrashid@gmail.com>",
  "sideEffects": false,
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean --tsconfig ../../tsconfig.base.json"
  }
